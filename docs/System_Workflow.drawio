            <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cell_22" value="Hết hạn [Không]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=1.5;fontSize=11;fontColor=#4a5568;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cell_9" target="cell_10">
