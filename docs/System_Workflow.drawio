(POST /api/nhaphang)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dd6b20;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="450" y="520" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cell_13" value="Backend Validation:
- Kiểm tra IMEI trùng lặp trong DB
- Validate định dạng số lượng, đơn giá &gt; 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#38a169;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
