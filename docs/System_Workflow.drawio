        </mxCell>
        <mxCell id="cell_7" value="Nhấn &quot;Đặt Hàng&quot;
Điền thông tin giao hàng &amp; Mã KM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3182ce;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
