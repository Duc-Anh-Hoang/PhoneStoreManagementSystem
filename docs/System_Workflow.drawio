        <mxCell id="cell_25" value="Bàn giao thiết bị" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=1.5;fontSize=11;fontColor=#4a5568;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cell_11" target="cell_12">
