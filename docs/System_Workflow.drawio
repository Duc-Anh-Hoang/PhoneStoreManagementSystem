        <mxCell id="cell_11" value="Lựa chọn Phương thức Thanh toán:
COD hoặc VNPay QR/ATM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3182ce;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
