        </mxCell>
        <mxCell id="cell_7" value="Thu ngân / Bán lẻ
(POS Terminal: view-banhang)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="80" y="280" width="260" height="70" as="geometry" />
