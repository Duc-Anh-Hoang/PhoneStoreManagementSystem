        <mxCell id="cell_8" value="Quản lý / Thủ kho / Kỹ thuật
(Admin Portal: admin.html)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="80" y="460" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cell_9" value="Tra cứu Bảo hành Công khai
(Lookup Page: lookup.js theo IMEI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf8ff;strokeColor=#3182ce;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="80" y="640" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cell_10" value="Nginx Alpine Server
- Static Web Serving (HTML/CSS/JS)
- Reverse Proxy /api/ -&gt; :8080
- SSL Termination &amp; Gzip Compression
- Rate Limiting &amp; Security Headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#dd6b20;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="450" y="320" width="200" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cell_11" value="Middleware Pipeline
(Global Error Handler, JWT Auth, FluentValidation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#319795;strokeColor=#234e52;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="760" y="100" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cell_12" value="Auth &amp; Security Feature
- JWT Token Gen, BCrypt
- Quyền: Admin, Quản lý, Thu ngân, Kho, Kỹ thuật" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#319795;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="760" y="190" width="235" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cell_13" value="Product &amp; Catalog Feature
- Quản lý Hàng hóa, Nhóm hàng, Loại hàng
- Chi tiết thuộc tính cấu hình" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#319795;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="1025" y="190" width="235" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cell_14" value="Online Orders Feature
- Tạo đơn hàng, áp mã khuyến mãi
- Duyệt đơn, cập nhật trạng thái đơn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#319795;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="760" y="290" width="235" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cell_15" value="POS Sales &amp; Invoicing Feature
- Bán hàng tại quầy, xuất Hóa đơn
- Trừ tồn kho &amp; Gán IMEI đã bán" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#319795;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="1025" y="290" width="235" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cell_16" value="Inventory &amp; Purchasing Feature
- Phiếu nhập hàng từ NCC
- Quản lý danh sách IMEI theo lô" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#319795;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="760" y="390" width="235" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cell_17" value="Warranty Feature
- Kích hoạt bảo hành tự động
- Tra cứu IMEI, Tiếp nhận sửa chữa (State Machine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#319795;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="1025" y="390" width="235" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cell_18" value="Payment Feature
- VNPay Gateway (URL builder, IPN Verify)
- Tiền mặt, Thẻ, Chuyển khoản" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#319795;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="760" y="490" width="235" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cell_19" value="Dashboard &amp; Reporting Feature
- Doanh thu theo kênh (Online/POS)
- Top bán chạy, Tồn kho cảnh báo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#319795;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="1025" y="490" width="235" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cell_20" value="Email Notification Service
- Gửi OTP, Xác nhận đơn hàng, Hóa đơn VAT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#319795;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="760" y="590" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cell_21" value="PostgreSQL 16 Database
(23 Tables, Triggers, Views, Sequences)
- DonHangOnline, ChiTietDonHangOnline
- HoaDon, ChiTietHoaDon, BaoHanh
- PhieuNhap, IMEI, MatHang
- PhieuTiepNhanBaoHanh, TraHang
- NhanVien, TaiKhoan, KhachHang" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f7fafc;strokeColor=#805ad5;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="1370" y="160" width="320" height="250" as="geometry" />
        </mxCell>
        <mxCell id="cell_22" value="VNPay Sandbox / Live
- Cổng thanh toán trực tuyến
- Xác thực chữ ký điện tử HMAC-SHA512" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#e53e3e;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="1370" y="480" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cell_23" value="SMTP Mail Server (Gmail / SendGrid)
