        <mxCell id="cell_14" value="Khách thanh toán:
Tiền mặt / Quẹt thẻ POS / QR Chuyển khoản" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3182ce;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="80" y="590" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cell_15" value="Thu ngân bấm &quot;Thanh toán &amp; Xuất hóa đơn&quot;
(POST /api/hoadon)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dd6b20;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="450" y="590" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cell_16" value="Database Transaction (BeginTransactionAsync):
1. Tạo bản ghi HoaDon (Mã sinh từ seq_HoaDon)
2. Lưu ChiTietHoaDon
3. Đổi IMEI -&gt; &quot;da_ban&quot; &amp; gán SoHD
4. Trừ số lượng tồn MatHang.SoLuongTon
5. Tự động kích hoạt phiếu BaoHanh (hạn tính theo tháng)
6. Cộng điểm tích lũy vào KhachHang
7. Commit Transaction" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#e6fffa;strokeColor=#319795;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="860" y="570" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cell_17" value="In Hóa đơn bán lẻ
&amp; Bàn giao máy cho khách hàng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dd6b20;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="450" y="760" width="280" height="60" as="geometry" />
        </mxCell>
