        <mxCell id="cell_5" value="HỆ THỐNG / STATE MACHINE" style="swimlane;startSize=30;rounded=1;arcSize=6;fontSize=14;fontStyle=1;align=center;fillColor=#faf5ff;strokeColor=#e9d8fd;strokeWidth=2;html=1;" vertex="1" parent="1">
            <mxGeometry x="1210" y="40" width="350" height="950" as="geometry" />
        </mxCell>
        <mxCell id="cell_6" value="Khách mang thiết bị lỗi đến
hoặc tra cứu trước trên Web" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4299e1;strokeColor=#4a5568;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="80" y="100" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cell_7" value="Nhân viên tra cứu số IMEI:
GET /api/baohanh/imei/{imei}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dd6b20;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="430" y="100" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cell_8" value="Kiểm tra Hạn Bảo hành
trên hệ thống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#805ad5;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="1240" y="100" width="290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cell_9" value="Còn hạn
bảo hành?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#dd6b20;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="1305" y="195" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cell_10" value="Hết hạn BH: Thông báo khách
chuyển sang dịch vụ sửa chữa có tính phí" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#e53e3e;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="430" y="200" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cell_11" value="Tạo Phiếu Tiếp Nhận Bảo Hành
- Ghi nhận hiện trạng, mô tả lỗi
- In giấy hẹn trả máy cho khách
Trạng thái: [tiep_nhan]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dd6b20;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="430" y="300" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cell_12" value="Gán Kỹ thuật viên phụ trách
(MaNV_KyThuat có quyền Kỹ thuật &amp; Bảo hành)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#38a169;fontColor=#2d3748;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="820" y="305" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cell_13" value="Bắt đầu chẩn đoán &amp; tháo lắp sửa chữa
Chuyển trạng thái: [dang_sua]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#feebc8;strokeColor=#dd6b20;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="820" y="420" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="cell_14" value="Thiếu linh kiện thay thế?
Chuyển trạng thái: [cho_linh_kien]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7d7;strokeColor=#e53e3e;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="820" y="530" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="cell_15" value="Sửa chữa xong &amp; Kiểm tra chức năng đạt
Chuyển trạng thái: [hoan_thanh]
Gửi SMS/Email thông báo khách đến nhận máy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c6f6d5;strokeColor=#22543d;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="820" y="640" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cell_16" value="Khách kiểm tra máy, ký nhận &amp; nhận lại thiết bị
Chuyển trạng thái: [da_tra]
Tự động gán NgayTra = UtcNow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bee3f8;strokeColor=#2b6cb0;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="430" y="770" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cell_17" value="State Machine Guard Rules:
- tiep_nhan -&gt; dang_sua
- dang_sua &lt;-&gt; cho_linh_kien
- dang_sua / cho_linh_kien -&gt; hoan_thanh
- hoan_thanh -&gt; da_tra
* Bất kỳ chuyển đổi sai -&gt; 409 Conflict" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f7fafc;strokeColor=#805ad5;fontColor=#2d3748;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="1240" y="450" width="290" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cell_18" value="Hoàn tất Quy trình Bảo hành 🤝" style="ellipse;whiteSpace=wrap;html=1;fillColor=#48bb78;strokeColor=#4a5568;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;" vertex="1" parent="1">
            <mxGeometry x="80" y="780" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cell_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=1.5;fontSize=11;fontColor=#4a5568;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cell_6" target="cell_7">
            <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cell_20" value="Gửi IMEI tra cứu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4a5568;strokeWidth=1.5;fontSize=11;fontColor=#4a5568;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cell_7" target="cell_8">
