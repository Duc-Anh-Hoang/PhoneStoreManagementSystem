        <mxCell id="cell_4" value="KỸ THUẬT VIÊN (Technician)" style="swimlane;startSize=30;rounded=1;arcSize=6;fontSize=14;fontStyle=1;align=center;fillColor=#f0fff4;strokeColor=#c6f6d5;strokeWidth=2;html=1;" vertex="1" parent="1">
