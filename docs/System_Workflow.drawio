        <mxCell id="cell_2" value="1. CLIENT TIER (Giao diện người dùng)" style="swimlane;startSize=30;rounded=1;arcSize=6;fontSize=14;fontStyle=1;align=center;fillColor=#e8f4fd;strokeColor=#90cdf4;strokeWidth=2;html=1;" vertex="1" parent="1">
