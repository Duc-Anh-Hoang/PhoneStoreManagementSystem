  <diagram id="page-5" name="5. Luồng Tiếp nhận Bảo hành &amp; State Machine Sửa chữa">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cell_2" value="KHÁCH HÀNG (Customer)" style="swimlane;startSize=30;rounded=1;arcSize=6;fontSize=14;fontStyle=1;align=center;fillColor=#ebf8ff;strokeColor=#bee3f8;strokeWidth=2;html=1;" vertex="1" parent="1">
            <mxGeometry x="50" y="40" width="320" height="950" as="geometry" />
        </mxCell>
        <mxCell id="cell_3" value="TIẾP NHẬN BẢO HÀNH (Front Desk)" style="swimlane;startSize=30;rounded=1;arcSize=6;fontSize=14;fontStyle=1;align=center;fillColor=#fffaf0;strokeColor=#feebc8;strokeWidth=2;html=1;" vertex="1" parent="1">
