# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU (ENV TEMPLATE)
# Copy file này thành .env để chạy cục bộ hoặc trên Docker: cp .env.example .env
# ==============================================================================

# Database PostgreSQL
POSTGRES_DB=PhoneStoreDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_PORT=5432

# Backend .NET 10
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=8080
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=PhoneStoreDB;Username=postgres;Password=postgres_secure_pass_2026

# JWT Security
Jwt__Key=PhoneStoreManagementSystem_SuperSecretKey_2026_AspNetCore10_StrongSecretKey!
Jwt__Issuer=PhoneStoreAPI
Jwt__Audience=PhoneStoreClient
Jwt__ExpireMinutes=1440

# Frontend Port
FRONTEND_PORT=80
PROD_PORT=80

# OTP & Vận chuyển (Giai đoạn 4 & 6 - không đặt Token thật ở đây)
OTP_MODE=demo
SHIPPING_MODE=mock
GHN_TOKEN=
GHN_SHOP_ID=
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_WEBHOOK_SECRET=
SPX_TRACKING_URL=https://spx.vn/track?{tracking_code}
