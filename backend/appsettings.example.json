{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=PhoneStoreDB;Username=postgres;Password=YOUR_POSTGRES_PASSWORD"
  },
  "Jwt": {
    "Key": "YOUR_STRONG_JWT_SECRET_KEY_AT_LEAST_32_CHARS_LONG",
    "Issuer": "PhoneStoreAPI",
    "Audience": "PhoneStoreClient",
    "ExpireMinutes": 1440
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost",
      "http://localhost:80",
      "http://localhost:8088",
      "http://localhost:8080",
      "http://localhost:5500",
      "http://127.0.0.1:5500"
    ]
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "SenderName": "Sama Mobile Store",
    "SenderEmail": "support@samamobile.vn",
    "Username": "your_email@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD"
  }
}
